# Quarry environment — adjust per deployment target.
# Schema: quarry/config.py (Settings). All fields: QUARRY_<FIELD_NAME>.
# Priority: env var > .env > config.py defaults

# ── Base ──
# QUARRY_DATA_DIR=~/.local/share/quarry

# ── PostgreSQL ──
# QUARRY_PG_CONNINFO=host=/tmp/quarry-pg dbname=quarry

# ── ClickHouse ──
# QUARRY_CH_HOST=localhost
# QUARRY_CH_PORT=9000
# QUARRY_CH_DATABASE=quarry

# ── Performance tuning ──
# cpu bounded (CH SELECT uses max_threads internally). Low concurrency = more threads/query.
# QUARRY_CH_EXPORT_MAX_CONCURRENT=4
# network bounded. NCBI FTP caps per-IP connections.
# QUARRY_FTP_PARALLEL=4

# ── Data paths (derived from DATA_DIR — override only if non-standard layout) ──
# QUARRY_PUBMED_BASELINE_DIR=
# QUARRY_PUBMED_UPDATE_DIR=
# QUARRY_PUBMED_MESH_DIR=
# QUARRY_ICITE_DIR=
# QUARRY_OA_LOCAL_DIR=
# QUARRY_OA_PARQUET_DIR=
# QUARRY_PM_PARQUET_DIR=
# QUARRY_MESH_PARQUET_DIR=
# QUARRY_PARQUET_DIR=
# QUARRY_CSR_DIR=
# QUARRY_LANCEDB_URI=

# ── FTP sources ──
# QUARRY_PUBMED_FTP_HOST=ftp.ncbi.nlm.nih.gov
# QUARRY_PUBMED_FTP_BASELINE=/pubmed/baseline/
# QUARRY_PUBMED_FTP_UPDATES=/pubmed/updatefiles/
# QUARRY_MESH_FTP_HOST=nlmpubs.nlm.nih.gov
# QUARRY_MESH_FTP_DIR=/online/mesh/MESH_FILES/xmlmesh/

# ── iCite ──
# QUARRY_ICITE_FIGSHARE_COLLECTION=4586573

# ── OpenAlex ──
# QUARRY_OA_S3_PREFIX=s3://openalex/data/works

# ── R2 (Cloudflare) ──
# QUARRY_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# QUARRY_R2_BUCKET=quarry-data
# Auth via AWS CLI credential chain (not managed by QUARRY_*):
#   AWS_ACCESS_KEY_ID=<R2 API token access key>
#   AWS_SECRET_ACCESS_KEY=<R2 API token secret key>

# ── Embeddings (GPU) ──
# QUARRY_EMBED_BATCH_SIZE=32         # GPU forward pass batch; OOM-sensitive (VRAM dependent)
# QUARRY_EMBED_MAX_TOKENS=1024       # tokenizer truncation ceiling
# QUARRY_EMBED_ENCODE_BATCH=1024     # works per GPU encode batch (CH fetch → encode)
# QUARRY_EMBED_ALLOWED_TYPES=["article","preprint","review","dissertation","book-chapter","letter","editorial","report","book"]

# ── Export ──
# QUARRY_CH_EXPORT_ROW_GROUP_SIZE=100000  # parquet row group size

