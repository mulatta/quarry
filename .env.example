# Base data directory (default: $XDG_DATA_HOME/quarry)
# QUARRY_DATA_DIR=/path/to/data

# PostgreSQL
# QUARRY_PG_CONNINFO=host=/tmp/quarry-pg dbname=quarry

# ClickHouse
# QUARRY_CH_HOST=localhost
# QUARRY_CH_PORT=9001
# QUARRY_CH_DATABASE=quarry

# R2 (Cloudflare)
# QUARRY_R2_ENDPOINT=
# QUARRY_R2_BUCKET=quarry-data

# AWS Batch
# QUARRY_BATCH_JOB_QUEUE=quarry-spot
# QUARRY_BATCH_JOB_DEFINITION=quarry-etl
