# Quarry environment — 48-core / 188GB RAM / NVMe RAID0 x2 (15TB /workspace)
# Schema: quarry/config.py (Settings). All fields: QUARRY_<FIELD_NAME>.

# ── Base ──
QUARRY_DATA_DIR=/workspace/seungwon/quarry-data

# ── PostgreSQL ──
QUARRY_PG_CONNINFO=host=/tmp/quarry-pg dbname=quarry

# ── ClickHouse ──
QUARRY_CH_HOST=localhost
QUARRY_CH_PORT=9000
QUARRY_CH_DATABASE=quarry

# ── Performance tuning ──
# cpu bounded (CH SELECT uses max_threads internally). 48 cores / 6 = 8 threads/query.
QUARRY_CH_EXPORT_MAX_CONCURRENT=6
# network bounded. NCBI FTP caps per-IP connections.
QUARRY_FTP_PARALLEL=4

# ── Data paths (derived from DATA_DIR — override only if non-standard layout) ──
QUARRY_PUBMED_BASELINE_DIR=/workspace/seungwon/quarry-data/raw/pubmed/baseline
QUARRY_PUBMED_UPDATE_DIR=/workspace/seungwon/quarry-data/raw/pubmed/updatefiles
QUARRY_PUBMED_MESH_DIR=/workspace/seungwon/quarry-data/raw/pubmed/mesh
QUARRY_ICITE_DIR=/workspace/seungwon/quarry-data/raw/icite
QUARRY_OA_LOCAL_DIR=/workspace/seungwon/quarry-data/raw/openalex/works
QUARRY_OA_PARQUET_DIR=/workspace/seungwon/quarry-data/staging/oa
QUARRY_PM_PARQUET_DIR=/workspace/seungwon/quarry-data/staging/pubmed
QUARRY_MESH_PARQUET_DIR=/workspace/seungwon/quarry-data/staging/mesh
QUARRY_PARQUET_DIR=/workspace/seungwon/quarry-data/staging/export
QUARRY_CSR_DIR=/workspace/seungwon/quarry-data/serving/csr
QUARRY_LANCEDB_URI=/workspace/seungwon/quarry-data/serving/lancedb

# ── FTP sources ──
QUARRY_PUBMED_FTP_HOST=ftp.ncbi.nlm.nih.gov
QUARRY_PUBMED_FTP_BASELINE=/pubmed/baseline/
QUARRY_PUBMED_FTP_UPDATES=/pubmed/updatefiles/
QUARRY_MESH_FTP_HOST=nlmpubs.nlm.nih.gov
QUARRY_MESH_FTP_DIR=/online/mesh/MESH_FILES/xmlmesh/

# ── iCite ──
QUARRY_ICITE_FIGSHARE_COLLECTION=4586573

# ── OpenAlex ──
QUARRY_OA_S3_PREFIX=s3://openalex/data/works

# ── R2 (Cloudflare) ──
# Auth via AWS CLI credential chain (not managed by QUARRY_*):
#   AWS_ACCESS_KEY_ID=<set in shell or ~/.aws/credentials>
#   AWS_SECRET_ACCESS_KEY=<set in shell or ~/.aws/credentials>
QUARRY_R2_ENDPOINT=
QUARRY_R2_BUCKET=quarry-data

# ── Embeddings (GPU) ── A6000 48GB
QUARRY_EMBED_BATCH_SIZE=256
QUARRY_EMBED_MAX_TOKENS=1024
QUARRY_EMBED_ENCODE_BATCH=1024
QUARRY_EMBED_INDEX_ACCELERATOR=cuda

# ── Export ──
# QUARRY_CH_EXPORT_ROW_GROUP_SIZE=100000  # default; takes effect on next parquet_export

